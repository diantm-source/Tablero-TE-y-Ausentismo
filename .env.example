# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH: Ruta base donde se publicará la aplicación.
# Para IIS en la raíz del sitio (http://servidor/) usar '/' (valor por defecto).
# Para IIS como sub-aplicación o directorio virtual (http://servidor/PanelTE/) usar '/PanelTE/'.
# Para GitHub Pages usar '/Tablero-TE-y-Ausentismo/'.
VITE_BASE_PATH="/"

# VITE_SHEETS_CSV_URL: URL pública de la hoja de cálculo de Google Sheets (Concentrado Anual de Tiempo Extra)
# Permite la sincronización remota continua y automática sin tener que subir manualmente archivos Excel.
# Nota: Si se utiliza un vínculo con '/pubhtml', la aplicación lo transformará automáticamente a '/pub?output=csv'.
VITE_SHEETS_CSV_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vQB-L3Tzyt1IA9t8Ifmjp4z1QVSIvkToguAcoTipw0SZ-WaZp2g5c3dCyWxQQKB95mFQQPYkrRFlrm3/pubhtml"

# VITE_SHEETS_AUSENTISMO_CSV_URL: URL pública de la hoja de cálculo de Google Sheets que procesa el AUSENTISMO (Concentrado de Ausencias)
# Permite sincronizar automáticamente las incidencias, faltas injustificadas, importes y líderes de área desde Google Sheets.
# Nota: Si se utiliza un vínculo con '/pubhtml', la aplicación lo transformará automáticamente a '/pub?output=csv'.
VITE_SHEETS_AUSENTISMO_CSV_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vQBrwUDfzZ94wGnudb02K1U2ZRZSeJlCVlabUQRoAfE4p6Y4hnreTwYgIc7oKKtNIX64HJPyLkpxujg/pubhtml"

# Registro_Prolongacion: Matriz Semanal de Tiempo Extra y Prolongación de Jornada (.xlsx publicado desde Google Sheets)
# Identificador: Registro_Prolongacion
# Procesa el desglose de Horas Extra Normales (color) y Prolongación de Jornada (0.5 en T1/T2 y 1.0 en T3 sin relleno)
VITE_SHEETS_REGISTRO_PROLONGACION_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vRA6U41IpBZZdoxc7lsOi3dTdE6fvIWJvtxZQnSDfsvKnixxX0K9fmb31poiAB31w/pub?output=xlsx"
VITE_SHEETS_MATRIZ_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vRA6U41IpBZZdoxc7lsOi3dTdE6fvIWJvtxZQnSDfsvKnixxX0K9fmb31poiAB31w/pub?output=xlsx"

